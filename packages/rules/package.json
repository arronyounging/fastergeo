{
  "name": "@fastergeo/rules",
  "version": "0.2.3",
  "description": "FasterGEO rule engine — deterministic GEO/SEO/content lint with agent-fixable suggestions. Forked from @ijonis/geo-lint (MIT).",
  "license": "MIT",
  "keywords": [
    "seo",
    "geo",
    "generative-engine-optimization",
    "linter",
    "mdx",
    "markdown",
    "content",
    "ai-search",
    "llm",
    "build-tool",
    "claude-code",
    "claude-code-skill",
    "agent-skill"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "require": "./dist/text.cjs"
    }
  },
  "bin": {
    "geo-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arronyounging/fastergeo",
    "directory": "packages/rules"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://fastergeo.co"
}
