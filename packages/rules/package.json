{
  "name": "@fastergeo/rules",
  "version": "0.2.1",
  "description": "FasterGEO rule engine \u2014 deterministic GEO/SEO/content lint with agent-fixable suggestions. Forked from @ijonis/geo-lint (MIT).",
  "license": "MIT",
  "keywords": [
    "seo",
    "geo",
    "generative-engine-optimization",
    "linter",
    "mdx",
    "markdown",
    "content",
    "ai-search",
    "llm",
    "build-tool",
    "claude-code",
    "claude-code-skill",
    "agent-skill"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "geo-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^3.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}