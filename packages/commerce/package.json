{
  "name": "@fastergeo/commerce",
  "version": "0.1.0",
  "description": "FasterGEO commerce — product-level GEO: ingest your catalog (Product JSON-LD / Shopify products.json), generate buying-intent question candidates, and check AI shopping answers deterministically — does AI recommend YOUR product, at the RIGHT price? Wrong prices are quoted with the evidence sentence: the commerce version of brand confusion.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastergeo/metrics": "workspace:^",
    "@fastergeo/rules": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arronyounging/fastergeo",
    "directory": "packages/commerce"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://fastergeo.co",
  "license": "Apache-2.0"
}
