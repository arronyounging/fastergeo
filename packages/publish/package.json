{
  "name": "@fastergeo/publish",
  "version": "0.1.0",
  "description": "FasterGEO publish — distribution connectors (WordPress REST, GitHub contents, signed webhooks) with a mandatory fabrication gate: content that fails lint against the fact store is refused, and forcing past the gate is recorded. Secrets referenced by env var name, never stored.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastergeo/content": "workspace:^",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arronyounging/fastergeo",
    "directory": "packages/publish"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://fastergeo.co",
  "license": "Apache-2.0"
}
