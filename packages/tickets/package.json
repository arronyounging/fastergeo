{
  "name": "@fastergeo/tickets",
  "version": "0.2.0",
  "description": "FasterGEO ticket system — diagnosis to actionable tickets with machine-verifiable acceptance criteria. Done means re-crawled and confirmed; regressions flip back automatically.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastergeo/audit": "workspace:^",
    "@fastergeo/metrics": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arronyounging/fastergeo",
    "directory": "packages/tickets"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://fastergeo.co"
}
